# BiBoTracker Admin Screenshot Configuration

# Target URL (defaults to https://bibotracker.com/admin)
BIBO_TARGET_URL=https://bibotracker.com/admin

# Optional: Admin credentials for automatic login & session renewal
BIBO_EMAIL=
BIBO_PASSWORD=

# Optional: Viewport dimensions for screenshot (defaults to 1920x1080)
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Directory to save screenshots
SCREENSHOTS_DIR=screenshots
